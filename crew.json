    {
      "id": "edit",
      "label": "편집",
      "agent": "editor",
      "room": "edit",
      "out": "rough.mp4",
      "tools": [
        "ffmpeg"
      ]
    },
    {
      "id": "color",
      "label": "컬러",
      "agent": "colorist",
      "room": "edit",
      "out": "final.mp4",
      "tools": [
        "finish.sh"
      ]
    },
    {
      "id": "qa",
      "label": "QA",
      "agent": "critic",
      "room": "screen",
      "out": "qa-report.md",
      "tools": [
        "ffmpeg"
      ]
    },
    {
      "id": "gate2",
      "label": "최종본 승인",
      "agent": "boss",
      "room": "boss",
      "gate": true,
      "out": "승인/보류",
      "tools": []
