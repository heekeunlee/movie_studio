      "id": "check",
      "label": "검수",
      "agent": "checker",
      "room": "writers",
      "out": "check.md",
      "tools": [
        "WebSearch"
      ]
    },
    {
      "id": "shotlist",
      "label": "샷 리스트",
      "agent": "director",
      "room": "writers",
      "out": "shotlist.json",
      "tools": []
    },
    {
      "id": "prompts",
      "label": "프롬프트",
      "agent": "dop",
      "room": "stage",
      "out": "prompts.md",
      "tools": []
    },
    {
      "id": "gate1",
      "label": "기획 승인",
      "agent": "boss",
      "room": "boss",
      "gate": true,
      "out": "승인/보류",
      "tools": [
        "카카오톡 알림"
      ]
    },
    {
      "id": "keyframes",
      "label": "키프레임",
      "agent": "keyframe",
      "room": "stage",
      "out": "keyframes/",
      "tools": [
        "힉스필드 웹"
      ]
    },
    {
      "id": "clips",
      "label": "클립 생성",
      "agent": "animator",
      "room": "stage",
      "out": "clips/",
      "tools": [
        "Kling · 힉스필드"
      ]
    },
    {
      "id": "objects",
      "label": "3D 렌더",
      "agent": "blender",
      "room": "stage",
      "optional": true,
      "out": "objects/",
      "tools": [
        "Blender MCP"
      ]
    },
    {
      "id": "audio",
      "label": "사운드",
      "agent": "sound",
      "room": "sound",
      "out": "audio/cue.md",
      "tools": [
        "ElevenLabs",
        "Suno"
      ]
